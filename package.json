{
  "name": "desk-tracking",
  "version": "1.8.0",
  "description": "Desk Tracking – einfache Zeiterfassung als Windows-Desktop-App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-store.js && node test-i18n.js",
    "dist": "electron-builder",
    "release": "electron-builder --win --publish always"
  },
  "author": "CaroWebAgentur",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "de.carowebdesign.stempeluhr",
    "productName": "Desk Tracking",
    "publish": [
      {
        "provider": "github",
        "owner": "CaroWebAgentur",
        "repo": "desk-tracking",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "icon.ico",
      "icon.png",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desk Tracking",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Desk-Tracking-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
